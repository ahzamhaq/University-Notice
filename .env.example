# Supabase project settings (Project Settings -> API). Use the service_role key:
# it is only read server-side (Python scripts + Next.js API route), never sent to the browser.
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key
# Optional: the anon/public key, used only by the live test that checks the tables are locked down.
SUPABASE_ANON_KEY=your_supabase_anon_key

# Local Ollama server
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_CHAT_MODEL=llama3.2

# --- Hosted mode (for deploying to Vercel, where Ollama can't run) ---------------------
# Leave the providers as "ollama" to run everything locally and offline.
# "cloudflare" uses Cloudflare Workers AI (free plan): the same bge-m3 embedding model that
# ingestion stores (identical vectors) and a hosted Llama model for answers.
# Token: Cloudflare dashboard -> Manage account -> Account API tokens, with Workers AI permissions only.
EMBED_PROVIDER=ollama
LLM_PROVIDER=ollama
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8-fast
